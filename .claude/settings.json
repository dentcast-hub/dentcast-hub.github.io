{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-.}}\"; { git -C \"$d\" config core.hooksPath >/dev/null || git -C \"$d\" config core.hooksPath .githooks; } 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-.}}/scripts/cursor-parity-notice.mjs\"",
            "timeout": 10,
            "statusMessage": "بررسی همسانی Claude/Cursor"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-.}}/scripts/publishing-stop-guard.py\"",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
