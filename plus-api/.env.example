# --- Database ---------------------------------------------------------------
# The API and the migration tool both read DATABASE_URL. In local dev this
# points at the Postgres container from docker-compose.yml.
DATABASE_URL=postgres://dentcast:dentcast@localhost:5432/dentcast_plus

# --- HTTP server ------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Comma-separated list of allowed browser origins (the static site).
# In dev the site is usually served from a file:// or a local http server.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# --- Sessions ---------------------------------------------------------------
# Secret used to sign the httpOnly session cookie. Change in production.
SESSION_SECRET=dev-insecure-change-me-in-production-000000000000000000000000
# Cookie flags. In production behind HTTPS set SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_NAME=dcp_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# --- OTP --------------------------------------------------------------------
# In dev the code is printed to the server console (SMS_PROVIDER=console).
# In production set SMS_PROVIDER=smsir (SMS.ir) — no business-logic change.
SMS_PROVIDER=console
OTP_TTL_SECONDS=120
OTP_LENGTH=5
# Rate limits (per phone and per IP) for OTP requests.
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=15

# SMS.ir (template-based OTP via https://api.sms.ir/v1/send/verify). Only used
# when SMS_PROVIDER=smsir. Create a template in the SMS.ir panel with ONE
# parameter that carries the code; put its numeric id in SMSIR_TEMPLATE_ID and,
# if that parameter isn't named CODE, its name in SMSIR_PARAM_NAME.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM_NAME=CODE

# --- Notifications ----------------------------------------------------------
# Delivery channels behind the provider-agnostic send() interface. COMMA-SEPARATED:
# a single value picks one channel; several fan out to all (each skips users who
# lack that channel), so a message reaches every channel the user has connected.
#   stub     - dev: logs instead of delivering
#   webpush  - browser / installed PWA push
#   telegram - Telegram messenger (needs TELEGRAM_BOT_TOKEN; user must have linked)
#   bale     - Bale (بله) messenger (needs BALE_BOT_TOKEN; user must have connected)
# Production: webpush,telegram,bale
NOTIFY_PROVIDER=stub
# Bot API token. Serves BOTH the Telegram notification channel AND "Login with
# Telegram" on dentcast.org (the /auth/telegram/callback endpoint verifies the
# widget payload with SHA256 of this token). The bot USERNAME is public and set
# on the frontend (plus/js/config.js), not here. In BotFather run
# `/setdomain` -> dentcast.org so the widget renders on the site.
TELEGRAM_BOT_TOKEN=
# Second login bot for the .ir site (a bot's /setdomain is bound to ONE domain,
# so .ir needs its own bot @Dentcast_irbot with /setdomain dentcast.ir). The
# login callback accepts a payload signed by EITHER bot; leave empty if unused.
TELEGRAM_BOT_TOKEN_IR=
TELEGRAM_WEBHOOK_SECRET=
# Max age (seconds) of a Telegram login payload before it is rejected (default 24h).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Bale (بله) — domestic messenger, NOTIFICATION channel only (no login widget).
# One bot (@dentcast_bot on ble.ir). Its Bot API mirrors Telegram's but is hosted
# on BALE_API_BASE. A user connects Bale from their profile: the connect button
# deep-links to ble.ir/dentcast_bot?start=<token>, and when they press Start the
# bot's webhook (/webhooks/bale/<secret>) links their chat_id.
BALE_BOT_TOKEN=
# Secret embedded in the webhook URL path. Register the webhook once with Bale's
# setWebhook pointing at https://api.dentcast.ir/webhooks/bale/<this-secret>.
BALE_WEBHOOK_SECRET=
# Bale Bot API host (rarely changes).
BALE_API_BASE=https://tapi.bale.ai

# --- Outbound network (the international channels) ---------------------------
# Telegram (api.telegram.org) and web push (fcm.googleapis.com, web.push.apple.com)
# are OUTSIDE Iran; Bale is domestic. A pod without international egress therefore
# loses exactly two of the three channels while Bale keeps working — this happened
# on 2026-07-26 after a redeploy and was invisible for hours.
#
# THE PROXY IS PER CHANNEL. There used to be one shared key, so a proxy added to
# rescue Telegram was mounted on web push as well; if it could not reach FCM/APNs
# it killed web push, which had been working direct, while Bale kept delivering.
# One knob could not say "Telegram through a proxy, web push direct".
#
# Telegram's route. http://host:port, credentials allowed. Empty = direct.
OUTBOUND_PROXY_URL=
# Web push's OWN route, and the only variable that moves it. Empty = DIRECT,
# which is the normal case and the default: FCM/APNs are reachable directly from
# the pod today. Nothing else — not OUTBOUND_PROXY_URL, not HTTPS_PROXY — can put
# web push behind a proxy.
WEBPUSH_PROXY_URL=
# NOTE: HTTPS_PROXY / https_proxy are deliberately NOT read. They used to be a
# fallback for OUTBOUND_PROXY_URL, which let a platform-level variable nobody set
# for notifications reroute delivery. If one is set and no notification proxy is,
# the API logs a warning at startup rather than honouring it in silence.
# Hard timeout for one notification send. Without it a filtered host can hang the
# request until the socket dies, stalling every user behind it in the batch.
OUTBOUND_TIMEOUT_MS=10000
# Timeout for the reachability checks in GET /admin/notify/health (diagnosis, so
# it fails fast).
OUTBOUND_PROBE_TIMEOUT_MS=5000
# Circuit breaker for a channel whose host has gone away. OUTBOUND_TIMEOUT_MS is
# per USER, so a fan-out over N readers costs N x that on a dead route: on
# 2026-08-07 a broadcast to every reader ran past the gateway timeout and left the
# API degraded for minutes, entirely on Telegram timeouts. After this many
# CONSECUTIVE network failures the channel is skipped instantly, and after the
# cooldown exactly one trial request decides whether it is back — a route that
# returns heals itself with no deploy. An HTTP answer (even a 403) never counts
# as a failure: that means the route works and one user is unreachable.
# Watch it at GET /admin/notify/health -> channels.telegram.breaker.
OUTBOUND_BREAKER_THRESHOLD=3
OUTBOUND_BREAKER_COOLDOWN_MS=300000

# --- Zibal payment gateway (درگاه پرداخت) ------------------------------------
# 'zibal' is Zibal's own SANDBOX merchant: the full request -> start -> callback
# -> verify round trip, no money. It is the default on purpose, so an
# unconfigured deployment is in test mode rather than half-broken.
ZIBAL_MERCHANT=zibal
# The gateway itself. Also the base for the URL the CUSTOMER'S BROWSER opens
# (/start/<trackId>), which is why it stays the real gateway even when the two
# server-to-server calls are proxied below.
ZIBAL_BASE_URL=https://gateway.zibal.ir
ZIBAL_CALLBACK_URL=https://api.dentcast.ir/pay/callback
# Zibal whitelists ONE outbound IP and this container's egress IP is not stable
# across redeploys. pay.dentcast.ir (188.121.121.232) is our fixed-IP REVERSE
# proxy: it forwards path, method and body verbatim to gateway.zibal.ir, so only
# the source IP changes. Set BOTH of these together — the proxy 403s a request
# without the token. Empty = call the gateway directly.
ZIBAL_API_BASE_URL=
ZIBAL_PROXY_TOKEN=
# A FORWARD proxy (CONNECT tunnel) — the other way to fix the egress IP, for a
# host that runs one instead of the reverse proxy above. Ours does not.
ZIBAL_EGRESS_PROXY_URL=
# Longer than OUTBOUND_TIMEOUT_MS: a payment switch is slower than a messenger
# API, and a verify that times out is the expensive kind — the customer has paid.
ZIBAL_TIMEOUT_MS=25000
# The monthly ceiling from the e-namad registration. Both are hard: the gateway
# starts refusing once either is reached, which to a customer looks like a broken
# site — hence PAYMENT_CAP_ALERT_PHONE.
PAYMENT_CAP_RIAL=1000000000
PAYMENT_CAP_COUNT=100
PAYMENT_CAP_ALERT_PHONE=
# FALSE since 2026-08-06: the allowance governs real transactions, so an
# abandoned checkout must not hold a slice of it.
PAYMENT_CAP_COUNTS_ATTEMPTS=false
# Reconciling payments the customer never came back from. Before this existed,
# a row where somebody paid and then closed the tab stayed 'pending' forever:
# money taken, no subscription, nothing that would ever notice. The sweep asks
# the gateway (read-only inquiry, never verify) and then finishes or closes it.
# AFTER_MINUTES must sit well past any bank session — below it, "unpaid" just
# means the customer is still typing their card number.
PAYMENT_RECONCILE_AFTER_MINUTES=30
PAYMENT_RECONCILE_EVERY_MINUTES=15
PAYMENT_RECONCILE_BATCH=50

# --- Web Push (VAPID) -------------------------------------------------------
# Generate a keypair once:  npx web-push generate-vapid-keys
# The PUBLIC key is served to the browser at /push/public-key (safe to expose);
# the PRIVATE key must stay secret. With both empty (dev), the webpush provider
# logs instead of sending, so the whole flow still runs without secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:foad.shahabian@gmail.com

# --- New-article notifications ----------------------------------------------
# Premium is pushed immediately on publish. Free is batched into one digest by a
# daily cron at ARTICLE_FREE_DIGEST_HOUR (local, Asia/Tehran) for articles whose
# notify_free_after (published_at + ARTICLE_FREE_DELAY_HOURS) has passed. The
# effective free delay is therefore 24-48h ("۱ تا ۲ روز").
ARTICLE_FREE_DELAY_HOURS=24
ARTICLE_FREE_DIGEST_HOUR=21

# --- Reactivation nudge (no-streak users) -----------------------------------
# Gentle once-a-day "start your streak" push (both channels) to users with no
# live streak. Opt-out (respects a disabled streak reminder) and capped per user.
REACTIVATION_HOUR=20
REACTIVATION_MAX_NUDGES=6

# --- Review (Leitner) reminder — PREMIUM ONLY -------------------------------
# Once a day, to premium users with cards due. Morning by default and NOT 20:00:
# that hour already carries the streak reminder and the reactivation nudge.
REVIEW_REMINDER_HOUR=9

# --- Notification delivery policy -------------------------------------------
# NOTIFY_MAX_PER_DAY: hard cap per user per Tehran day, across every kind except
# `system` (the founder broadcast, which always lands). Instant delivery means a
# busy day can stack up; excess is DROPPED, not queued.
NOTIFY_MAX_PER_DAY=5
# Awake window (Tehran) for the EVENT-DRIVEN kinds — the new-article premium push
# and the league outcome. Inside it they fire the moment the event happens;
# outside it they are HELD (not dropped) and released by the morning sweep at
# NOTIFY_AWAKE_START_HOUR. Half-open: 22:00 sharp already waits. Set both to the
# same value to disable the window and fire at any hour.
NOTIFY_AWAKE_START_HOUR=9
NOTIFY_AWAKE_END_HOUR=22

# --- Anonymous events -------------------------------------------------------
ANON_EVENT_MAX_PER_IP_PER_HOUR=60

# Ceiling on activity rows one ACCOUNT may write per hour (routes/activity.ts).
# Every score, streak and badge is derived from these rows and nothing else
# checks that a row means a human did something: the action vocabulary is open
# by design and `card_reviewed_manual` deliberately touches no state. On
# 2026-08-08 an account passed a thousand weekly league XP inside a day through
# a loop of identical posts. Set far above real use — a heavy reading session is
# a few dozen rows an hour — so a reader never meets it and only a script does.
ACTIVITY_MAX_PER_USER_PER_HOUR=300

# --- Spot (ad) telemetry ----------------------------------------------------
# spot_impression / spot_click get their own, much larger budget: an impression
# fires per page view PER enabled slot, and many Iranian mobile readers share one
# NAT address, so the 60/h anonymous cap would drop real traffic. Applied per IP
# (guests) and per user (signed-in).
SPOT_EVENT_MAX_PER_IP_PER_HOUR=600

# --- Admin (founder-only KPI page) ------------------------------------------
# HTTP Basic auth for the /admin KPI endpoints.
ADMIN_USER=founder
ADMIN_PASSWORD=change-me-admin-password

# --- Timezone ---------------------------------------------------------------
# Day boundary for streaks. Do not change; the spec fixes this to Asia/Tehran.
STREAK_TIMEZONE=Asia/Tehran

# --- Content taxonomy index -------------------------------------------------
# Path to plus/content-index.json (tools/build_plus_index.mjs output). Empty =
# resolve the repo's plus/ dir automatically (dev). Set explicitly in the
# container, where the API and the static site are deployed separately.
CONTENT_INDEX_PATH=

# --- Learning pathways -------------------------------------------------------
# Path to plus/pathways.json (curated pathway definitions, spec section 5).
# Empty = resolve the repo's plus/ dir automatically (dev). Set explicitly in
# the container, where the API and the static site are deployed separately.
PATHWAYS_PATH=

# --- Achievement catalog -----------------------------------------------------
# Path to plus/badges.json (the profile's «افتخارات» badges + league medals).
# Same rule as PATHWAYS_PATH: empty resolves the repo's plus/ dir in dev.
BADGES_PATH=

# --- Runtime refresh of those files (content-refresh.ts) ---------------------
# The two paths above are baked into the image, so on their own EVERY publish
# would need a rebuild before the assistant, dashboard tree and pathway pages
# could see the new article. These URLs let the API re-fetch the published files
# while it runs. Comma-separated: the first mirror that answers wins, and the
# baked copy stays the boot value and the permanent fallback — a refresh can
# only ever be an upgrade, never a downgrade to nothing.
# Empty = off (the dev default: the on-disk file IS the live one).
# The Dockerfile already sets both to the .ir/.org mirrors in production.
CONTENT_INDEX_URL=
PATHWAYS_URL=
BADGES_URL=
# How often to re-fetch, in seconds (default 300, floor 30).
CONTENT_REFRESH_SECONDS=

# --- «دستیار هوشمند» AI narrowing (premium) ----------------------------------
# The AI's only job is a multiple-choice narrowing round over our OWN taxonomy —
# never a chatbot, never clinical advice. AI_PROVIDER=stub (default) is free and
# needs no key (deterministic dev/test behavior). Only openai-compatible spends
# real money, and only against an explicitly configured endpoint — set it to
# Arvan's OpenAI-compatible endpoint + API key in production.
AI_PROVIDER=stub
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
# Retry: the Arvan gateway intermittently answers a valid request with a generic
# 400 that succeeds unchanged seconds later, so transient failures (400/429/5xx,
# timeouts, empty or non-JSON bodies) are retried. AI_MAX_ATTEMPTS caps the calls;
# AI_RETRY_BUDGET_MS caps the wall clock, since a user waits on this. Auth/routing
# failures (401/403/404) are never retried — those mean the key or URL is wrong.
AI_MAX_ATTEMPTS=3
AI_RETRY_BUDGET_MS=15000
# JSON mode (response_format=json_object) turns "answer in JSON" into a hard
# guarantee — on endpoints that support it. ArvanCloud's gateway does NOT: it
# rejects the whole request with a bare 400. The provider detects that on the
# first such 400, latches JSON mode off for the process and falls back to
# prompt-enforced JSON (the parser tolerates ```json fences). DEFAULTS TO FALSE
# because that self-healing costs one doomed round trip on every container boot
# for a result we already measured. Set true only for an endpoint that honours it.
AI_JSON_MODE=false
# Sized to the model actually serving. On GPT-5-Nano the median round is 2.6s
# and the slowest observed 4.3s, so 10s is ~2x headroom and anything past it is
# a stall, not a slow answer. Pairs with AI_RETRY_BUDGET_MS: the loop checks the
# budget before sleeping, so worst case is about attempts x timeout + backoffs.
# 10s/15s gives 2 attempts and a ~20s ceiling; a fast failure still gets all 3.
AI_TIMEOUT_MS=10000
# Hard cost bounds: at most this many AI calls per case description, and at most
# this many new case descriptions per user per hour.
ASSISTANT_MAX_ROUNDS=4
ASSISTANT_MAX_PER_USER_PER_HOUR=20
