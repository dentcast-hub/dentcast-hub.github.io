ary/phosphoric-acid.html\" class=\"pillar-item-link\">\n          <span class=\"pillar-item-icon\" aria-hidden=\"true\"><svg class=\"dc-svg-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/> <path d=\"M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z\"/></svg></span>\n          <span class=\"pillar-item-title\">Phosphoric Acid</span>\n          <span class=\"sr-only\"> گلاسری</span>\n        </a>\n      </li>\n      <li class=\"pillar-item\" data-type=\"glossary\">\n        <a href=\"/glossary/tertiary-amines.html\" class=\"pillar-item-link\">\n          <span class=\"pillar-item-icon\" aria-hidden=\"true\"><svg class=\"dc-svg-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/> <path d=\"M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z\"/></svg></span>\n          <span class=\"pillar-item-title\">Tertiary Amines</span>\n          <span class=\"sr-only\"> گلاسری</span>\n        </a>\n      </li>\n      <li class=\"pillar-item\" data-type=\"glossary\">\n        <a href=\"/glossary/unfilled-resin.html\" class=\"pillar-item-link\">\n          <span class=\"pillar-item-icon\" aria-hidden=\"true\"><svg class=\"dc-svg-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/> <path d=\"M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z\"/></svg></span>\n          <span class=\"pillar-item-title\">Unfilled Resin</span>\n          <span class=\"sr-only\"> گلاسری</span>\n        </a>\n      </li>\n      </ul>\n      <div class=\"pillar-card-fade\" aria-hidden=\"true\"></div>\n    </div>\n  </details>\n  <details class=\"pillar-card\" data-subtopic=\"strategies\">\n    <summary class=\"pillar-card-summary\">\n      <span class=\"pillar-card-icon\" aria-hidden=\"true\"><svg class=\"dc-svg-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/> <path d=\"m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 