#!/usr/bin/env bash
# Pre-commit guards. Two independent checks, in order:
#   1. Reject staged TEXT files containing NUL bytes.
#   2. Warn when the hand-maintained instruction files drift apart.
#
# ── 1. NUL bytes ────────────────────────────────────────────────────────────
#
# NUL bytes in text files are corruption — the write/sync layer in some editing
# environments appends NUL padding after a file's real content (and has, on
# occasion, zeroed a span mid-file). Such files read as "binary", so they vanish
# from grep and text tooling and can be committed silently. This guard inspects
# the STAGED content (the index) — exactly the bytes that would enter the commit —
# and aborts if any text file carries a NUL byte.
#
# Activate once per clone:  git config core.hooksPath .githooks
# Override (only if certain): git commit --no-verify
set -euo pipefail

is_text() {
  case "${1,,}" in
    *.html|*.htm|*.css|*.js|*.mjs|*.cjs|*.json|*.md|*.txt|*.svg|*.xml|*.webmanifest|*.yml|*.yaml|*.py) return 0 ;;
    *) return 1 ;;
  esac
}

bad=()
while IFS= read -r -d '' f; do
  is_text "$f" || continue
  # Inspect the staged blob, not the working-tree copy.
  if git show ":$f" 2>/dev/null | LC_ALL=C grep -qaP '\x00'; then
    n=$(git show ":$f" | LC_ALL=C tr -cd '\000' | wc -c | tr -d ' ')
    bad+=("$f ($n NUL byte(s))")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#bad[@]})); then
  echo "" >&2
  echo "  COMMIT REJECTED - NUL bytes found in text file(s):" >&2
  printf '      %s\n' "${bad[@]}" >&2
  echo "" >&2
  echo "  This is the trailing-padding corruption from the write/sync layer." >&2
  echo "  Clean with:  python3 tools/strip_text_nuls.py <file>" >&2
  echo "  Override (only if certain):  git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# ── 2. Instruction-side drift ───────────────────────────────────────────────
#
# Two hand-written sides — Claude (CLAUDE.md + AGENTS.md) and Cursor
# (.cursor/rules/*.mdc) — must say the same thing, so publishing via Cursor
# matches publishing via Claude. One side moving ALONE means the other was
# probably forgotten. The check reads STAGED bytes, so a commit that doesn't
# touch either side can never be blocked by them.
#
# On drift this ASKS, because only a human knows whether an edit concerns the
# other side. The question needs a terminal: git gives a hook no stdin, so it is
# read from /dev/tty. Without one (CI, GUI client, piped input) it falls back to
# blocking with the report, which is the safe direction.
#
# Exit 1 = drift. Exit 2 = the check itself couldn't run; warn, don't block a
# commit over a broken guard.
if command -v node >/dev/null 2>&1 && [ -f scripts/check-workflow-sync.mjs ]; then
  set +e
  sync_out=$(node scripts/check-workflow-sync.mjs --staged 2>&1)
  sync_rc=$?
  set -e

  if [ "$sync_rc" -eq 1 ]; then
    printf '%s\n' "$sync_out" >&2

    # Testing -e/-r is not enough: /dev/tty exists as a node but opening it fails
    # with ENXIO when the process has no controlling terminal (CI, piped input).
    # Only a real open proves there is someone to ask.
    # The probe runs in a SUBSHELL: on the same command line bash applies
    # `3</dev/tty` before `2>/dev/null`, so a failed open still prints its error.
    # Wrapping it means the subshell's stderr — error included — is what gets
    # discarded, and its exit status tells us whether the open would succeed.
    if ( : </dev/tty ) 2>/dev/null; then
      exec 3</dev/tty
      printf '  [y] بله، باید اعمال شود   → کامیت متوقف می‌شود تا الان انجامش بدهی\n' >&2
      printf '  [n] نه، ربطی ندارد        → همین الان reconciled ثبت می‌شود و کامیت ادامه پیدا می‌کند\n' >&2
      printf '  [s] بعداً تصمیم می‌گیرم   → کامیت متوقف می‌شود، چیزی ثبت نمی‌شود\n' >&2
      printf '\n  اعمال شود روی سمت دیگر؟ [y/n/s] ' >&2
      read -r answer <&3 || answer=s
      exec 3<&-

      case "$answer" in
        n | N)
          # "This edit does not concern the other side." Record it and let the
          # commit carry the updated state file, so the same question is not
          # asked again on the next commit.
          if node scripts/check-workflow-sync.mjs --ack --staged >/dev/null 2>&1 &&
            git add .workflow-sync.json; then
            echo "  ✓ ثبت شد (.workflow-sync.json به کامیت اضافه شد) — ادامه." >&2
            echo "" >&2
            exit 0
          fi
          echo "  ✗ ثبت نشد؛ کامیت متوقف شد." >&2
          echo "" >&2
          exit 1
          ;;
        y | Y)
          echo "" >&2
          echo "  کامیت متوقف شد. سمت دیگر را به‌روز کن، بعد هر دو را با هم کامیت کن." >&2
          echo "" >&2
          exit 1
          ;;
        *)
          echo "" >&2
          echo "  کامیت متوقف شد. Override (فقط اگر مطمئنی):  git commit --no-verify" >&2
          echo "" >&2
          exit 1
          ;;
      esac
    fi

    # No terminal to ask on — block with the report.
    echo "  Override (only if certain):  git commit --no-verify" >&2
    echo "" >&2
    exit 1

  elif [ "$sync_rc" -ne 0 ]; then
    printf '%s\n' "$sync_out" >&2
    echo "  (workflow-sync check skipped; commit allowed)" >&2
  fi
fi

exit 0
